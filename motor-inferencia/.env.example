SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key

# Solo el backend Node puede llamar a este motor
# Separa múltiples orígenes con coma
ALLOWED_ORIGINS=http://localhost:3000

# Mismo valor que INTERNAL_SECRET en api-backend
# Genera uno con: openssl rand -hex 32
INTERNAL_SECRET=

# Monitoreo de errores (opcional). Sin esto el servicio funciona igual,
# solo que los errores en producción no se reportan a ningún lado.
SENTRY_DSN=

# Credenciales para test_sistema_selenium.py (cuenta de prueba, no de producción)
TEST_EMAIL=
TEST_PASSWORD=
