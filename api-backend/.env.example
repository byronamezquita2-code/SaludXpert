SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key
SUPABASE_SERVICE_KEY=tu-service-role-key
PORT=3000

# URL del motor de inferencia Flask (local o en producción)
MOTOR_URL=http://localhost:5000

# Dominios autorizados a llamar esta API (separados por comas)
# Ejemplo producción: https://saludxpert.netlify.app
ALLOWED_ORIGIN=http://127.0.0.1:5500

# Secret compartido con el motor Flask — cámbialo por un valor aleatorio seguro
# Ejemplo: openssl rand -hex 32
INTERNAL_SECRET=
